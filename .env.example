# ===============================
# JWT CONFIG
# ===============================
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
ACCESS_TOKEN_TTL=30d
REFRESH_TOKEN_TTL=7d

# ===============================
# DATABASE (MONGODB ATLAS)
# ===============================
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/saint_hari_ecom

# ===============================
# ADMIN DEFAULT CREDENTIALS
# ===============================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# ===============================
# EMAIL / SMTP SETTINGS
# ===============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
MAIL_FROM="Saint Hari <your_email@gmail.com>"
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# ===============================
# SERVER
# ===============================
NODE_ENV=development
PORT=9006

# ⚠️ IMPORTANT: Change these on server deployment!
# Localhost:
SERVER_BASE_URL=http://localhost:9006
BACKEND_URL=http://localhost:9006
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Production (uncomment when deploying):
# SERVER_BASE_URL=https://api.yourdomain.com
# BACKEND_URL=https://api.yourdomain.com
# FRONTEND_URL=https://yourdomain.com
# ALLOWED_ORIGINS=https://yourdomain.com
